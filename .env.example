# Public production site URL (used for canonical URLs, sitemap, Open Graph).
# No trailing slash. In production this defaults to https://jsonyamltools.com
# (see src/lib/config.ts); set this to override for a different domain or a
# preview environment. Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://jsonyamltools.com

# Placeholder GitHub repository URL shown in the header/footer.
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/your-repo

# Set to "true" to render advertising placeholder slots. Hidden by default so
# they never appear during development. No real ad network is integrated.
NEXT_PUBLIC_ENABLE_ADS=false

# Maximum client-side upload size in bytes (default 10485760 = 10 MB). Files
# larger than this are rejected in the browser before any processing.
NEXT_PUBLIC_MAX_FILE_BYTES=10485760

# --- Future server functionality (NOT required to build or run today) --------
# Stripe keys would live here once billing is added via Route Handlers.
# Never commit real secrets; use your deployment platform's secret storage.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
